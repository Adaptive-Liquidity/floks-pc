{
  "name": "flok-node-runtime",
  "version": "0.0.1",
  "private": true,
  "description": "FLOKS Agent Computer Cloud — isolated Agent Computers for Grok Bots. Runloop Devbox is provider v1. MCP gateway, pairing, capability auth. Standalone until Gate G0.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/tsx/dist/cli.mjs --test tests/domain/**/*.test.ts tests/providers/**/*.test.ts tests/security/**/*.test.ts tests/ci/**/*.test.ts tests/web/**/*.test.ts",
    "web:verify": "npm --prefix web run verify",
    "test:domain": "node --experimental-vm-modules node_modules/tsx/dist/cli.mjs --test tests/domain/**/*.test.ts",
    "test:providers": "node --experimental-vm-modules node_modules/tsx/dist/cli.mjs --test tests/providers/**/*.test.ts",
    "test:live": "node --experimental-vm-modules node_modules/tsx/dist/cli.mjs --test tests/live/**/*.test.ts",
    "test:live:docker": "node --experimental-vm-modules node_modules/tsx/dist/cli.mjs --test tests/providers/docker-dev.isolation.test.ts",
    "test:live:runloop": "node --experimental-vm-modules node_modules/tsx/dist/cli.mjs --test tests/providers/runloop.isolation.test.ts tests/live/runloop.live.test.ts",
    "test:live:runloop-c3b": "node --experimental-vm-modules node_modules/tsx/dist/cli.mjs --test tests/live/runloop.c3b.live.test.ts",
    "test:live:runloop-l1-fs": "node --experimental-vm-modules node_modules/tsx/dist/cli.mjs --test tests/live/l1-fs.live.test.ts",
    "test:live:mcp": "node --experimental-vm-modules node_modules/tsx/dist/cli.mjs --test tests/live/mcp.grok.live.test.ts",
    "build": "tsc",
    "verify": "npm run typecheck && npm run typecheck:scripts && npm test && npm run build",
    "typecheck:scripts": "tsc --noEmit --strict --module NodeNext --moduleResolution NodeNext --target ES2022 --types node --skipLibCheck scripts/merge-gate.ts scripts/apply-main-protection.ts scripts/destroy-floks-run.ts",
    "merge-gate": "node --experimental-vm-modules node_modules/tsx/dist/cli.mjs scripts/merge-gate.ts",
    "protect:main": "node --experimental-vm-modules node_modules/tsx/dist/cli.mjs scripts/apply-main-protection.ts",
    "start:mcp": "node --experimental-vm-modules node_modules/tsx/dist/cli.mjs src/mcp-server.ts",
    "computers:destroy-run": "node --experimental-vm-modules node_modules/tsx/dist/cli.mjs scripts/destroy-floks-run.ts"
  },
  "dependencies": {
    "@runloop/api-client": "1.28.0",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./computers": "./src/lib/computers/index.ts",
    "./mcp": "./src/lib/mcp/index.ts",
    "./providers": "./src/lib/computers/providers/index.ts"
  }
}
