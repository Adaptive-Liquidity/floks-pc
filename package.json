{
  "name": "flok-node-runtime",
  "version": "0.0.1",
  "private": true,
  "description": "Isolated Flok Node Computer runtime — per-Node VMs, MCP gateway, pairing, jobs, checkpoints, handoffs. Standalone until Gate G0.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/tsx/dist/cli.mjs --test tests/domain/**/*.test.ts tests/providers/**/*.test.ts tests/security/**/*.test.ts",
    "test:domain": "node --experimental-vm-modules node_modules/tsx/dist/cli.mjs --test tests/domain/**/*.test.ts",
    "test:providers": "node --experimental-vm-modules node_modules/tsx/dist/cli.mjs --test tests/providers/**/*.test.ts",
    "test:live": "node --experimental-vm-modules node_modules/tsx/dist/cli.mjs --test tests/live/**/*.test.ts",
    "test:live:docker": "node --experimental-vm-modules node_modules/tsx/dist/cli.mjs --test tests/providers/docker-dev.isolation.test.ts",
    "build": "tsc",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "typescript": "^5.7.0",
    "tsx": "^4.19.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./computers": "./src/lib/computers/index.ts",
    "./providers": "./src/lib/computers/providers/index.ts"
  }
}
