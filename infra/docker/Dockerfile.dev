# Flok Computer — local DockerDev image. DEV ONLY. Never pull :latest.
# Base is pinned by immutable digest (source pin). Runtime image ID is CI evidence.
FROM ubuntu:24.04@sha256:33ceb71981b602c1a7443a53469e4dba065f7503eab3078a2d7a57a2ab987517

ARG INSTALL_CHROMIUM=0

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      bash \
      coreutils \
      ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && mkdir -p /workspace \
 && chown 1000:1000 /workspace

# Chromium is Phase 7. Keep off for C2. Ubuntu 24.04's chromium-browser is a
# snap transitional package and must not be used when Phase 7 is opened.
RUN if [ "$INSTALL_CHROMIUM" = "1" ]; then \
      echo "C2 image does not install Chromium; Phase 7 must use a native .deb" >&2; \
      exit 1; \
    fi

WORKDIR /workspace
USER 1000:1000
CMD ["sleep", "infinity"]
