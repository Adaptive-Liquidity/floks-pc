# Shell scripts must stay LF on every platform. Tests compare
# ensure-interactive.sh byte-exact against an embedded LF constant, and bash
# scripts break under CRLF. Force LF regardless of the client's autocrlf.
*.sh text eol=lf

# Workflow YAML is parsed by tests with LF-sensitive regexes.
*.yml text eol=lf
*.yaml text eol=lf
