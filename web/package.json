{
  "name": "floks-pc-web",
  "private": true,
  "version": "0.0.1",
  "description": "floks-pc.com public frontend — marketing, AuthKit sign-in, Stripe seats, /setup desks.",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --port 3173 --hostname 127.0.0.1",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start --port 3173 --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "@runloop/api-client": "1.28.0",
    "@workos-inc/node": "^7.71.0",
    "next": "^15.5.2",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "stripe": "^18.5.0",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "typescript": "^5.7.0"
  }
}
