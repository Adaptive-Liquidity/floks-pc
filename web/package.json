{
  "name": "floks-pc-web",
  "private": true,
  "version": "0.0.1",
  "description": "floks-pc.com public frontend — pay, connect, status, revoke. UI only.",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --port 3173 --hostname 127.0.0.1",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start --port 3173 --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "next": "^15.5.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "typescript": "^5.7.0"
  }
}
