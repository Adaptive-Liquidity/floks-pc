    "@react-three/postprocessing": "^3.1.1",
    "@runloop/api-client": "1.28.0",
    "@workos-inc/node": "^7.71.0",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.0",
    "next": "^15.5.2",
    "pg": "^8.16.3",
    "postprocessing": "^6.39.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-parallax-tilt": "^1.7.343",
    "stripe": "^18.5.0",
    "three": "^0.186.0",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.16.5",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.12",
