# Public origin of this Next app. Never use https://floks-pc.com (host is down).
APP_URL=https://your-preview.vercel.app
NEXT_PUBLIC_SITE_ORIGIN=https://your-preview.vercel.app

# WorkOS AuthKit — CLIENT_ID and API_KEY must be the same environment
# (both Staging or both Production). Mismatch → invalid_client on /callback.
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_COOKIE_PASSWORD=
WORKOS_REDIRECT_URI=https://your-preview.vercel.app/callback

# Stripe. Preview = test-mode secret + test Price ids. Production = live.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PERSONAL=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
STRIPE_PORTAL_CONFIGURATION_ID=
STAXIONS_BIND_SECRET=
CHECKOUT_DISABLED=

# Postgres (Vercel Postgres / Neon). Required on Vercel and production.
DATABASE_URL=

# Support address shown on the site.
SUPPORT_EMAIL=contact@asentxia.com

# Cron (Vercel sends Authorization: Bearer CRON_SECRET).
CRON_SECRET=
STAXIONS_IDLE_MINUTES=30
STAXIONS_BILLING_GRACE_HOURS=72

# Runloop computers. Paying customers in Production cannot use FakeProvider.
# Do not set FLOK_WEB_PROVIDER=runloop in CI.
RUNLOOP_API_KEY=
FLOK_RUNLOOP_BLUEPRINT=flok-runloop-interactive
FLOK_WEB_PROVIDER=fake
FLOK_RUNLOOP_KEEP_ALIVE_SECONDS=

# Local-only JSON fallback. Ignored when DATABASE_URL is set.
# Forbidden on Vercel/production.
FLOK_SEAT_STORE_PATH=.flok/seats.json
FLOK_CONTROL_PLANE_PATH=.flok/control-plane.json

# Dev-only /setup?preview= fixtures. Ignored in production.
FLOK_WEB_PREVIEW=0
