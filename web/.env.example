# Public origin of this Next app (Vercel preview or production).
NEXT_PUBLIC_SITE_ORIGIN=https://floks-pc.com

# Hosted Stripe Payment Links. Do not invent Checkout Sessions here.
NEXT_PUBLIC_STRIPE_SPARK_URL=https://buy.stripe.com/dRm5kv54s8FO5NR0ES6wE00
NEXT_PUBLIC_STRIPE_DESK_URL=https://buy.stripe.com/dRm00b9kI2hqfor3R46wE01
NEXT_PUBLIC_STRIPE_SHIFT_URL=https://buy.stripe.com/eVq28j7cA5tCccf1IW6wE02

# WorkOS AuthKit (names only — never commit values).
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_COOKIE_PASSWORD=
WORKOS_REDIRECT_URI=

# Stripe seat bind + Customer Portal + webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Runloop desks. FakeProvider unless FLOK_WEB_PROVIDER=runloop AND both secrets below.
# Do not set FLOK_WEB_PROVIDER=runloop in CI. Creating a pair key provisions.
RUNLOOP_API_KEY=
FLOK_RUNLOOP_BLUEPRINT=flok-runloop-interactive
FLOK_WEB_PROVIDER=fake

# Durable stores. JSON stays under .flok. DATABASE_URL uses migrations/0003_web_seats.sql.
FLOK_CONTROL_PLANE_PATH=.flok/control-plane.json
FLOK_SEAT_STORE_PATH=.flok/seats.json
DATABASE_URL=

# Dev-only /setup?preview= fixtures. Ignored in production.
FLOK_WEB_PREVIEW=0
